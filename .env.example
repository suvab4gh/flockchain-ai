# ── Soroban Smart Contract (Tier 2) ────────────────────────────────────────────
# Set after running: cd contracts && bash deploy.sh
# When unset, the system automatically falls back to Classic Horizon manageData.
# SOROBAN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── MPP Agentic Payments (Tier 3) ──────────────────────────────────────────────
# Set MPP_ENABLED=true to require ECO_KUKK micropayment for /api/predict calls.
# AI agents automatically handle 402 responses via @stellar/mpp client SDK.
# Leave false (default) for open access during demos and judging.
MPP_ENABLED=false
# MPP_AMOUNT=0.01          # ECO_KUKK per prediction (default: 0.01)

# ── Prediction Engine ──────────────────────────────────────────────────────────
# NOTE: No ANTHROPIC_API_KEY required.
# Predictions are handled exclusively by two engines:
#   1. PRIMARY: Local Python ML server (ml/app.py) — XGBoost + LSTM + PPO RL
#      Set ML_SERVER_URL below when running locally with the ML server.
#      Leave it UNSET on Vercel (the route will skip ML and use the fallback instantly).
#   2. FALLBACK: ICAR-CARI / DADF / BIS 10500 rule-based engine (lib/prediction.ts)
#      Runs entirely serverless, zero external API dependencies.
# To train models: cd ml && python train_indian_dataset_pipeline.py

# ── NVIDIA NIM — MiniMax M2.7 AI (Tier 2 prediction engine) ─────────────────
# Get your API key at: https://integrate.api.nvidia.com
# When set, /api/predict uses MiniMax M2.7 as the AI prediction engine.
# When unset, the system falls back to the ICAR-CARI rule engine (Tier 3).
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Python ML server (local dev only — do NOT set on Vercel)
# ML_SERVER_URL=http://127.0.0.1:8000/predict


# ── Auto-Alert & Vet Dispatch (NEW) ────────────────────────────────────────────
# Stellar wallet of the registered district vet.
# /api/alert sends 0.5 XLM here when disease risk ≥ 70%.
# If unset or starts with "GDEMO", the system uses simulation mode (no real payment).
# VET_WALLET_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

